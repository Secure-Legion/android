<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_black">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:background="@color/header_bg"
        android:fitsSystemWindows="true"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/backButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/top_icon_bg"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_back_arrow"
                app:tint="#FFFFFF"
                android:contentDescription="Back" />

        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Help Center"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/space_grotesk_bold"
            android:textStyle="bold"
            android:gravity="center" />

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="8dp"
            android:visibility="invisible" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

            <!-- Section 1: Connection Issues -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/help_section_bg"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_tor_signal_2"
                        app:tint="@color/text_primary"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Connection Issues"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/space_grotesk_bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Check the connection pill at the top of the Messages screen. It shows your current Tor connection status.\n\n• Green (Connected) - Your connection is active and working normally.\n• Yellow (Connecting) - The app is still establishing a Tor connection. Wait a moment for it to finish.\n• Red (Disconnected) - The connection has failed or dropped. Tap the pill to open the VPN connect screen and reconnect.\n\nIf tapping the pill does not resolve the issue, go to Settings &gt; Tor VPN Settings and toggle the tunnel off, then back on to restart the connection."
                    android:textSize="14sp"
                    android:textColor="@color/text_muted"
                    android:fontFamily="@font/poppins_regular"
                    android:lineSpacingMultiplier="1.4" />

            </LinearLayout>

            <!-- Section 2: Bootstrap & Circuit Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/help_section_bg"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_tor_signal_full"
                        app:tint="@color/text_primary"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bootstrap &amp; Circuit Status"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/space_grotesk_bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="When connecting, you will see a bootstrap percentage that indicates how far along the Tor connection process is.\n\n• 0-24% - Starting up. The app is initializing the Tor client.\n• 25-49% - Loading network consensus.\n• 50-74% - Building circuits through the Tor network.\n• 75-99% - Almost ready. Circuits are being tested.\n• 100% - Fully connected.\n\n&quot;Established Circuit&quot; means your device has successfully built an encrypted route through multiple Tor relays."
                    android:textSize="14sp"
                    android:textColor="@color/text_muted"
                    android:fontFamily="@font/poppins_regular"
                    android:lineSpacingMultiplier="1.4" />

            </LinearLayout>

            <!-- Section 3: Tor Network Nodes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/help_section_bg"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_onion"
                        app:tint="@color/text_primary"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tor Network Nodes"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/space_grotesk_bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your connection is routed through multiple relays (nodes) for privacy. Each node only knows the node before and after it, so no single relay can see your full path.\n\n• Entry Node (Guard) - The first relay your device connects to. It knows your real IP address but cannot see your destination or message content.\n• Middle Node (Relay) - An intermediate relay that passes encrypted traffic between entry and exit nodes.\n• Exit Node - The final relay in the circuit. For hidden services (.onion addresses), there is no traditional exit node since traffic stays within the Tor network."
                    android:textSize="14sp"
                    android:textColor="@color/text_muted"
                    android:fontFamily="@font/poppins_regular"
                    android:lineSpacingMultiplier="1.4" />

            </LinearLayout>

            <!-- Section 4: Need More Help? -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/help_section_bg"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_about_info"
                        app:tint="@color/text_primary"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Need More Help?"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/space_grotesk_bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="If you are still experiencing issues or have questions not covered here:"
                    android:textSize="14sp"
                    android:textColor="@color/text_muted"
                    android:fontFamily="@font/poppins_regular"
                    android:lineSpacingMultiplier="1.4"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/startHelpChatButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Start a Help Chat"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="@font/poppins_medium"
                    android:background="@drawable/action_button_bg"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Or visit our help desk from any browser at:\nsecurelegion.org/help"
                    android:textSize="14sp"
                    android:textColor="@color/text_muted"
                    android:fontFamily="@font/poppins_regular"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.4" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
