<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Tab bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Emoji tab -->
        <FrameLayout
            android:id="@+id/tabEmoji"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/tabEmojiIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_emoji"
                app:tint="?attr/colorPrimary"
                android:contentDescription="Emojis" />
        </FrameLayout>

        <!-- Sticker tab -->
        <FrameLayout
            android:id="@+id/tabSticker"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/tabStickerIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_sticker"
                app:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="Stickers" />
        </FrameLayout>

        <!-- GIF tab -->
        <FrameLayout
            android:id="@+id/tabGif"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <TextView
                android:id="@+id/tabGifIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="GIF"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textStyle="bold" />
        </FrameLayout>

    </LinearLayout>

    <!-- Tab indicator line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#22FFFFFF" />

    <!-- Content area -->
    <ViewFlipper
        android:id="@+id/mediaFlipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Tab 0: Fluent Emoji picker (category pills + PNG grid) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/fluentCategoryPills"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/emojiGrid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:padding="4dp" />
        </LinearLayout>

        <!-- Tab 1: Sticker picker -->
        <com.securelegion.views.StickerPickerView
            android:id="@+id/stickerPicker"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Tab 2: GIF picker -->
        <com.securelegion.views.GifPickerView
            android:id="@+id/gifPicker"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </ViewFlipper>

    <!-- Close bar — same black/white chevron affordance used by the image
         attachment sheet, so dismissing any media tab (emoji / sticker / GIF)
         is visually obvious. -->
    <FrameLayout
        android:id="@+id/closeMediaKeyboard"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#000000"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_chevron_down"
            app:tint="#FFFFFF"
            android:contentDescription="Close media keyboard" />

    </FrameLayout>

</LinearLayout>
