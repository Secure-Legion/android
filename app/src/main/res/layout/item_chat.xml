<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false">

    <!-- Background Action Buttons (revealed on swipe right) -->
    <LinearLayout
        android:id="@+id/chatItemActions"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Mute Button -->
        <FrameLayout
            android:id="@+id/actionMute"
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:background="@color/swipe_mute"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_lock_silent_mode"
                    app:tint="#FFFFFF"
                    android:layout_marginBottom="4dp"
                    android:contentDescription="Mute"
                    xmlns:app="http://schemas.android.com/apk/res-auto" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mute"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:fontFamily="@font/poppins_medium" />
            </LinearLayout>
        </FrameLayout>

        <!-- Delete Button -->
        <FrameLayout
            android:id="@+id/actionDelete"
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:background="#FF3B30"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_menu_delete"
                    app:tint="#FFFFFF"
                    android:layout_marginBottom="4dp"
                    android:contentDescription="Delete"
                    xmlns:app="http://schemas.android.com/apk/res-auto" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Delete"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:fontFamily="@font/poppins_medium" />
            </LinearLayout>
        </FrameLayout>

        <!-- Pin Button -->
        <FrameLayout
            android:id="@+id/actionPin"
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:background="#FF9500"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_input_add"
                    app:tint="#FFFFFF"
                    android:layout_marginBottom="4dp"
                    android:contentDescription="Pin"
                    xmlns:app="http://schemas.android.com/apk/res-auto" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pin"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:fontFamily="@font/poppins_medium" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

    <!-- Foreground Content (swipeable) -->
    <LinearLayout
        android:id="@+id/chatItemForeground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="@color/surface_black">

        <!-- Top border line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/list_item_divider" />

        <!-- Chat content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:gravity="center_vertical">

        <!-- Avatar Circle -->
        <com.securelegion.views.AvatarView
            android:id="@+id/chatAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/profile_circle_bg"
            android:layout_marginEnd="16dp" />

        <!-- Chat Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Name and Time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/pinIcon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_pin"
                    android:contentDescription="Pinned"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/chatName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@Wizard"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/space_grotesk_bold" />

                <!-- Time only (status moved inline with the preview below) -->
                <TextView
                    android:id="@+id/chatTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="1m ago"
                    android:textSize="13sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:fontFamily="@font/poppins_regular" />

            </LinearLayout>

            <!-- Preview row: message text on the left, delivery status on the right
                 (under the time). Both share the same baseline / row. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/chatMessage"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="What's good? How are you."
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:fontFamily="@font/poppins_regular"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Message status label, right-aligned under the time. Adapter
                     toggles visibility based on lastMessageIsSent (received
                     messages hide it cleanly via GONE). -->
                <TextView
                    android:id="@+id/chatMessageStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/message_status_pending"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:fontFamily="@font/poppins_medium"
                    android:contentDescription="Message status"
                    android:visibility="visible" />

            </LinearLayout>

        </LinearLayout>

        <!-- Download Button for Pending Messages -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/downloadButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/primary_button_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Download"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:textAllCaps="false"
            android:visibility="gone" />

        <!-- Unread Badge -->
        <TextView
            android:id="@+id/unreadBadge"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/unread_badge_bg"
            android:gravity="center"
            android:text="2"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/unread_badge_text"
            android:visibility="gone" />

        <!-- Hidden elements (not shown, kept for compatibility) -->
        <TextView
            android:id="@+id/onlineIndicator"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/securityBadge"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        </LinearLayout>

        <!-- Bottom border line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/list_item_divider" />

    </LinearLayout>

</FrameLayout>
