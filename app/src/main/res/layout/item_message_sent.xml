<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Timestamp Header (Day/Date) -->
    <TextView
        android:id="@+id/timestampHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Today"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp"
        android:paddingBottom="8dp"
        android:visibility="gone" />

    <!-- Message Content Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:paddingStart="60dp"
        android:paddingEnd="16dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Bubble + reactions -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:clipChildren="false"
            android:clipToPadding="false">

            <TextView
                android:id="@+id/reactionSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="-6dp"
                android:layout_gravity="start"
                android:translationX="-14dp"
                android:elevation="2dp"
                android:background="@drawable/reaction_glass_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:visibility="gone" />

            <!-- Message Bubble -->
            <LinearLayout
                android:id="@+id/messageBubble"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:maxWidth="280dp"
                android:background="@drawable/message_sent_bg"
                android:padding="12dp"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Reply quote block (shown when this message is a reply) -->
                    <LinearLayout
                        android:id="@+id/replyQuoteBlock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/reply_quote_sent_bg"
                        android:paddingStart="0dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:layout_marginBottom="4dp"
                        android:visibility="gone">

                        <View
                            android:layout_width="3dp"
                            android:layout_height="match_parent"
                            android:background="@color/reply_quote_border_sent" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="8dp">

                            <TextView
                                android:id="@+id/replyQuoteLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Replying to"
                                android:textColor="@color/reply_quote_label_sent"
                                android:textSize="12sp"
                                android:fontFamily="@font/poppins_medium" />

                            <TextView
                                android:id="@+id/replyQuoteText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/reply_quote_text_sent"
                                android:textSize="12sp"
                                android:maxLines="2"
                                android:ellipsize="end" />

                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/pinIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pinned"
                        android:textSize="10sp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/poppins_medium"
                    android:drawableStart="@drawable/ic_pin_small"
                        android:drawableTint="#FFFFFF"
                        android:drawablePadding="4dp"
                        android:layout_marginBottom="2dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/messageText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Message content"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:fontFamily="sans-serif-medium"
                        android:lineSpacingMultiplier="1.2" />

                    <TextView
                        android:id="@+id/editedLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(edited)"
                        android:textColor="@color/edited_label_sent"
                        android:textSize="11sp"
                        android:textStyle="italic"
                        android:layout_marginTop="2dp"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Delivery status indicator (circle with checkmarks) - right of text, inline with text baseline -->
                <ImageView
                    android:id="@+id/messageStatus"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/status_pending"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="2dp"
                    android:layout_gravity="bottom"
                    android:contentDescription="Message status"
                    android:visibility="visible" />

            </LinearLayout>

        </LinearLayout>

        <!-- Swipe-revealed timestamp (right side) -->
        <TextView
            android:id="@+id/swipeRevealedTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:34 PM"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:visibility="gone" />

        <!-- Selection Checkbox (shown in delete mode) -->
        <CheckBox
            android:id="@+id/messageCheckbox"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:visibility="gone"
            android:button="@drawable/circular_checkbox" />

    </LinearLayout>

</LinearLayout>

