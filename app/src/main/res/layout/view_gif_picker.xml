<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Placeholder message until GIFs are bundled -->
    <TextView
        android:id="@+id/gifPlaceholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="GIFs will be available in the next update"
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:fontFamily="@font/poppins_regular"
        android:visibility="gone" />

    <!-- GIF grid (shown when assets/gifs/ has content) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/gifGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="2dp" />

    <!-- Giphy attribution -->
    <ImageView
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:src="@drawable/powered_by_giphy"
        android:layout_gravity="start"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:contentDescription="Powered by GIPHY" />

</LinearLayout>
