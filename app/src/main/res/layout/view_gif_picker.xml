<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Header row: Manage button on the right (visible when the app has partial
         photo access so the user can add/remove which GIFs we can see). -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/gifManageButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="Manage"
            android:textSize="13sp"
            android:textColor="?attr/colorPrimary"
            android:fontFamily="@font/poppins_medium"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Placeholder message (shown when no GIFs yet or permission denied) -->
    <TextView
        android:id="@+id/gifPlaceholder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="GIFs will be available in the next update"
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:fontFamily="@font/poppins_regular"
        android:visibility="gone" />

    <!-- GIF grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/gifGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="2dp" />

</LinearLayout>
