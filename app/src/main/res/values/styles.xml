<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Alphabet Index Letter Style (for quick scroll) -->
    <style name="AlphabetIndexLetter">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">#666666</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <!-- Rounded corners for image messages -->
    <style name="RoundedImageShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- Dark rounded popup menu (message long-press actions) -->
    <style name="MessagePopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/message_popup_menu_bg</item>
        <item name="android:popupElevation">12dp</item>
        <item name="android:overlapAnchor">false</item>
    </style>

    <!-- ThemeOverlay applied via ContextThemeWrapper so PopupMenu picks up text color -->
    <style name="ThemeOverlay.MessagePopup" parent="ThemeOverlay.AppCompat.Dark">
        <item name="popupMenuStyle">@style/MessagePopupMenu</item>
        <item name="android:popupMenuStyle">@style/MessagePopupMenu</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:colorBackground">#000000</item>
    </style>
</resources>
