<?xml version="1.0" encoding="utf-8"?>
<!-- Attachment picker sheet background. Always black, regardless of theme,
     so the photo-preview area reads consistently. The icons-row panel that
     sits on top of this uses its own theme-aware drawable. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#000000" />
    <corners
        android:topLeftRadius="24dp"
        android:topRightRadius="24dp" />
</shape>
