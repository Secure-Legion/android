<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.SecureLegion" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">#888888</item>
        <item name="colorPrimaryContainer">#666666</item>
        <item name="colorOnPrimary">@color/text_white</item>
        <item name="colorOnPrimaryContainer">@color/text_white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">#888888</item>
        <item name="colorSecondaryContainer">#666666</item>
        <item name="colorOnSecondary">@color/text_white</item>
        <item name="colorOnSecondaryContainer">@color/text_white</item>
        <!-- Tertiary color. -->
        <item name="colorTertiary">#888888</item>
        <item name="colorTertiaryContainer">#666666</item>
        <item name="colorOnTertiary">@color/text_white</item>
        <item name="colorOnTertiaryContainer">@color/text_white</item>
        <!-- Surface colors - use color resources -->
        <item name="colorSurface">@color/surface_black</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_gray</item>
        <item name="colorSurfaceContainerLowest">@color/surface_black</item>
        <item name="colorSurfaceContainerLow">@color/dark_bg</item>
        <item name="colorSurfaceContainer">@color/card_bg</item>
        <item name="colorSurfaceContainerHigh">@color/surface_variant</item>
        <item name="colorSurfaceContainerHighest">@color/surface_variant</item>
        <!-- Outline -->
        <item name="colorOutline">@color/input_border</item>
        <item name="colorOutlineVariant">@color/border_color</item>
        <!-- Status bar - dark mode: light icons -->
        <item name="android:statusBarColor">@color/surface_black</item>
        <item name="android:navigationBarColor">@color/surface_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Background -->
        <item name="android:windowBackground">@color/surface_black</item>
        <item name="android:colorBackground">@color/surface_black</item>
        <!-- Text -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_gray</item>
        <item name="android:textColorHighlight">@color/surface_variant</item>
        <item name="android:textColorLink">#888888</item>
        <item name="colorControlHighlight">#444444</item>
        <!-- Controls -->
        <item name="colorAccent">#888888</item>
        <item name="colorControlActivated">#FFFFFF</item>
        <item name="colorControlNormal">@color/text_muted</item>
        <!-- AlertDialog styling -->
        <item name="alertDialogTheme">@style/CustomAlertDialog</item>
        <item name="materialAlertDialogTheme">@style/CustomAlertDialog</item>
    </style>

    <style name="CustomAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:background">@drawable/glass_dialog_bg</item>
        <item name="backgroundColor">@color/card_bg</item>
        <!-- Force ALL surface colors to same value so no internal panel stands out -->
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorSurfaceVariant">@color/card_bg</item>
        <item name="colorSurfaceContainerLowest">@color/card_bg</item>
        <item name="colorSurfaceContainerLow">@color/card_bg</item>
        <item name="colorSurfaceContainer">@color/card_bg</item>
        <item name="colorSurfaceContainerHigh">@color/card_bg</item>
        <item name="colorSurfaceContainerHighest">@color/card_bg</item>
        <!-- Disable elevation overlay that tints surfaces at different elevations -->
        <item name="elevationOverlayEnabled">false</item>
        <!-- Kill Material3 outlines everywhere inside dialog -->
        <item name="colorOutline">@android:color/transparent</item>
        <item name="colorOutlineVariant">@android:color/transparent</item>
        <item name="shapeAppearanceOverlay">@style/DialogRoundedCorners</item>
        <item name="buttonBarPositiveButtonStyle">@style/PositiveButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/NegativeButtonStyle</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_primary</item>
        <item name="materialAlertDialogTitleTextStyle">@style/DialogTitleTextStyle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/DialogBodyTextStyle</item>
        <!-- Kill internal panel backgrounds that draw outlines -->
        <item name="materialAlertDialogTitlePanelStyle">@style/DialogPanel.NoOutline</item>
    </style>

    <style name="PositiveButtonStyle" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">#888888</item>
    </style>

    <style name="NegativeButtonStyle" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/text_gray</item>
    </style>

    <style name="DialogRoundedCorners" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="DialogPanel.NoOutline" parent="MaterialAlertDialog.Material3.Title.Panel">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="DialogTitleTextStyle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="DialogBodyTextStyle" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Splash Screen Theme - Android 12+ system splash screen (Dark Mode) -->
    <style name="Theme.SecureLegion.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#000000</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenIconBackgroundColor">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="postSplashScreenTheme">@style/Theme.SecureLegion</item>
    </style>
</resources>
