    <!-- Reply/Edit UI -->
    <color name="reply_accent">#1E90FF</color>
    <!-- Dark mode: the sent bubble is solid blue so a blue quote bg vanishes.
         Use the same dark gray as the received-bubble reply quote (#1A1A1A,
         matches `surface_variant`) so the embedded quote reads as muted gray
         rather than harsh black. -->
    <color name="reply_quote_bg_sent">#1A1A1A</color>
    <color name="reply_quote_bg_received">#1A1A1A</color>
    <color name="reply_quote_bg_self">#1E90FF</color>
    <color name="reply_quote_border">#1E90FF</color>
    <!-- Split variants: sent bubble is solid blue in dark mode so the separator
         and label must be a light contrast color; received bubble is dark so
         the blue accent still reads. -->
    <color name="reply_quote_border_sent">#FFFFFF</color>
    <color name="reply_quote_border_received">#1E90FF</color>
    <color name="reply_quote_text_sent">#BBFFFFFF</color>
    <color name="reply_quote_text_received">#AAAAAA</color>
    <color name="reply_quote_label_sent">#FFFFFF</color>
    <color name="reply_quote_label_received">#1E90FF</color>
