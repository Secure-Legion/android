    <color name="edit_banner_bg">#1AF59E0B</color>
    <color name="edited_label">#1E90FF</color>
    <!-- Sent bubble is solid blue in dark mode — blue-on-blue makes the
         "(edited)" label invisible (regression from the dark-mode redesign).
         Match iOS's muted-white (~50% white) for sent, keep blue for received. -->
    <color name="edited_label_sent">#80FFFFFF</color>
    <color name="edited_label_received">#9CA3AF</color>

