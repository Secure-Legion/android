            android:taskAffinity=""
            android:excludeFromRecents="true" />

        <!-- GP TorService removed — Arti (in-process Rust Tor) replaces it -->

        <!-- Tor foreground service - Shows notification and handles Ping-Pong protocol -->
        <service
            android:name=".services.TorService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintains Tor hidden service for secure P2P messaging" />
        </service>

        <!-- Voice Tor service - Dedicated Tor instance for voice calling (Single Onion Service) -->
        <service
            android:name=".services.VoiceTorService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintains dedicated Tor instance for low-latency voice calls" />
        </service>

        <!-- Download message service - Handles background message downloads -->
        <service
            android:name=".services.DownloadMessageService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Downloads encrypted messages via Tor" />
        </service>

        <!-- Tor VPN Service - Routes all device traffic through Tor when enabled -->
        <service
            android:name=".services.TorVpnService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="systemExempted"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- AlarmManager restart receiver removed — WorkManager handles service health -->

        <!-- Boot receiver - Start services after device reboot -->
        <receiver
            android:name=".receivers.BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Unlock receiver - Triggers SecureRuntime init the moment the user unlocks
             the device, for headless wake paths (WorkManager/JobScheduler/etc.) where
             the process is alive but no Activity has been launched. -->
        <receiver
            android:name=".receivers.UnlockReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.USER_UNLOCKED" />
            </intent-filter>
        </receiver>

        <!-- FileProvider for sharing images -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

    </application>

</manifest>